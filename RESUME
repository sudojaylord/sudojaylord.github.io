:root[data-theme="dark"]{--bg:#0E151B;--paper:#151F27;--ink:#E4ECF1;--muted:#93A4B0;--line:#27363F;--accent:#5CC3DD;--chip:#1C2B35}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 var(--sans)}
a{color:var(--accent);text-decoration-thickness:1px;text-underline-offset:3px}
a:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.sheet{max-width:980px;margin:32px auto;background:var(--paper);border:1px solid var(--line);border-radius:6px}
header{padding:40px 44px 28px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap;align-items:flex-start}
h1{font:600 2.4rem/1.15 var(--serif);margin:0 0 6px;letter-spacing:-.01em}
.role{font-size:1.05rem;color:var(--accent);font-weight:500;margin:0}
.where{color:var(--muted);margin:4px 0 0}
.actions{display:flex;gap:10px;flex-wrap:wrap}
.btn{display:inline-block;padding:9px 16px;border:1px solid var(--accent);border-radius:4px;text-decoration:none;font-weight:500;font-size:.95rem}
.btn.primary{background:var(--accent);color:var(--paper)}
.theme{background:none;border:1px solid var(--line);color:var(--muted);border-radius:4px;padding:9px 12px;font:inherit;font-size:.95rem;cursor:pointer}
.grid{display:grid;grid-template-columns:300px 1fr}
aside{padding:28px 32px 40px 44px;border-right:1px solid var(--line)}
main{padding:28px 44px 40px 36px}
h2{font:600 1.15rem/1.3 var(--serif);margin:0 0 12px}
section+section{margin-top:30px}
aside h3{font-size:.95rem;font-weight:600;margin:16px 0 6px}
aside ul{list-style:none;padding:0;margin:0}
aside li{padding:3px 0;color:var(--muted);font-size:.95rem}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chips span{background:var(--chip);border-radius:3px;padding:2px 9px;font-size:.88rem}
.job h3{font-size:1.05rem;margin:0}
.job .org{color:var(--muted);margin:2px 0 0;font-size:.95rem}
.job .when{color:var(--accent);font-weight:500;font-size:.95rem;margin:2px 0 14px}
.job h4{font-size:.98rem;margin:16px 0 4px}
main ul{margin:0;padding-left:20px}
main li{margin:5px 0}
.cert{display:grid;grid-template-columns:110px 1fr;gap:4px 16px;font-size:.95rem}
.cert dt{font-weight:600}
.cert dd{margin:0 0 10px;color:var(--muted)}
.cert dd b{color:var(--ink);font-weight:500}
footer{padding:18px 44px;border-top:1px solid var(--line);color:var(--muted);font-size:.88rem}
@media (max-width:760px){
  .grid{grid-template-columns:1fr}
  aside{border-right:0;border-bottom:1px solid var(--line);padding:24px}
  main{padding:24px}
  header{padding:28px 24px 22px}
  footer{padding:16px 24px}
  .sheet{margin:0;border-radius:0;border-left:0;border-right:0}
  h1{font-size:1.9rem}
  .cert{grid-template-columns:1fr}
}
@media print{.actions{display:none}body{background:#fff}.sheet{border:0;margin:0}}
</style>
</head>
